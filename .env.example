# Flask Application Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-edumentor-change-in-production
DATABASE_URL=sqlite:///instance/edumentor.db
PORT=5000

# AI Mentor Configurable LLM Provider
# Supported providers: 'ollama' (recommended default), 'gemini', 'openai', 'offline'
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120

# Cloud AI Provider Keys (Optional Fallbacks)
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
