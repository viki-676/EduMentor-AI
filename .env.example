# =============================================================================
# EduMentor AI — Environment Configuration Template
# Copy this file to '.env' for local development:
#   copy .env.example .env
#
# IMPORTANT: Never commit '.env' or real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Local Development Configuration
# -----------------------------------------------------------------------------
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-edumentor-change-in-production
PORT=5000

# SQLite Database Location (defaults to instance/edumentor.db if unset)
DATABASE_URL=sqlite:///instance/edumentor.db

# -----------------------------------------------------------------------------
# 2. Production Deployment Configuration (Render Free Web Service)
# In Render Dashboard -> Environment Variables, configure:
#   FLASK_ENV=production
#   FLASK_DEBUG=0
#   SECRET_KEY=<generate_random_secret_string>
#   AI_PROVIDER=offline
#   RISK_DECISION_THRESHOLD=0.50
# -----------------------------------------------------------------------------

# Machine Learning Risk Decision Threshold (0.00 to 1.00, default: 0.50)
RISK_DECISION_THRESHOLD=0.50

# -----------------------------------------------------------------------------
# 3. AI Mentor Provider Configuration
# Supported providers:
#   - 'offline' : Built-in pedagogical knowledge engine (Recommended for free cloud hosting; 0 cost, 0 RAM overhead)
#   - 'ollama'  : Local Ollama daemon (Recommended for local desktop development: http://localhost:11434)
#   - 'gemini'  : Google Gemini API (Requires free GEMINI_API_KEY)
#   - 'openai'  : OpenAI or compatible endpoint (Requires OPENAI_API_KEY)
# -----------------------------------------------------------------------------
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120

# Optional Cloud LLM Keys (Leave empty unless using 'gemini' or 'openai' provider)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
